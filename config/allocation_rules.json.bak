{
  "version": 2,
  "_doc": "Allocation Check rules. See config/README.md for what each setting means. Most of this is editable in the app: Allocation Check -> Active rules.",
  "rounding": {
    "basis": 2500000,
    "mode": "half_up",
    "divisor": 100
  },
  "excluded_servers": [
    "dlr acc",
    "not running"
  ],
  "excluded_algos": [
    8,
    19,
    27
  ],
  "dte_filters": {
    "0DTE": {
      "runningtype": null,
      "runningdays": null
    },
    "1DTE": {
      "runningtype": [
        "pos"
      ],
      "runningdays": [
        "1dte/0dte",
        "daily"
      ]
    },
    "4DTE": {
      "runningtype": [
        "pos"
      ],
      "runningdays": [
        "daily"
      ]
    }
  },
  "weekday_modes": {
    "mon": "1DTE",
    "tue": "0DTE",
    "wed": "1DTE",
    "thu": "0DTE",
    "fri": "4DTE"
  },
  "maxloss_rules": {
    "0DTE": {
      "1": 1.0,
      "7": 0.8,
      "15": 1.0
    },
    "1DTE": {
      "1": 2.0,
      "7": 1.8,
      "15": 2.0
    },
    "4DTE": {
      "1": 2.0,
      "7": 1.8,
      "15": 2.0
    }
  },
  "previous_day": {
    "required": [
      "0DTE"
    ],
    "optional": [
      "1DTE"
    ],
    "unused": [
      "4DTE"
    ]
  },
  "routing": {
    "0DTE": {
      "with_previous_day": [
        {
          "method": "capital",
          "runningtype": [
            "int"
          ]
        },
        {
          "method": "previous_day",
          "runningtype": [
            "pos"
          ]
        }
      ],
      "without_previous_day": []
    },
    "1DTE": {
      "with_previous_day": [
        {
          "method": "capital",
          "runningtype": [
            "pos"
          ],
          "runningdays": [
            "1dte/0dte"
          ]
        },
        {
          "method": "previous_day",
          "runningtype": [
            "pos"
          ],
          "runningdays": [
            "daily"
          ]
        }
      ],
      "without_previous_day": [
        {
          "method": "capital"
        }
      ]
    },
    "4DTE": {
      "with_previous_day": [
        {
          "method": "capital"
        }
      ],
      "without_previous_day": [
        {
          "method": "capital"
        }
      ]
    }
  },
  "subcategories": {
    "CC": {
      "action": "check",
      "pct": 100
    },
    "CCG": {
      "action": "check",
      "pct": 100
    },
    "CCV": {
      "action": "check",
      "pct": 100
    },
    "MSS": {
      "action": "check",
      "pct": 100
    },
    "MSV": {
      "action": "check",
      "pct": 100
    },
    "MSR": {
      "action": "check",
      "pct": 100
    },
    "MSP": {
      "action": "check",
      "pct": 100
    },
    "MSN": {
      "action": "check",
      "pct": 100
    },
    "PVT": {
      "action": "check",
      "pct": 100
    },
    "PGB": {
      "action": "check",
      "pct": 100
    },
    "PPS": {
      "action": "check",
      "pct": 100
    },
    "MS": {
      "action": "check",
      "pct": 100
    },
    "MSRG": {
      "action": "check",
      "pct": 100
    },
    "PRD": {
      "action": "exclude",
      "pct": 0
    },
    "MSJ": {
      "action": "jexception"
    }
  },
  "broker_rules": {},
  "fix": {
    "enabled": true,
    "column": "fix_cr",
    "capital_multiplier": 10000000
  },
  "jainam": {
    "sheet_name": "Jainam",
    "userid_column": "UserID",
    "allocation_column": "ALLOCATION",
    "multiplier": 100000,
    "exclude_userids": [
      "total",
      "grand total",
      ""
    ]
  },
  "zero_sl": {
    "enabled": true,
    "sl_column": "sl",
    "max_loss_multiplier": 30
  },
  "today_mode": {
    "mode": "0DTE",
    "date": "2026-08-22",
    "by": "superadmin@gmail.com"
  },
  "maxloss_subcategory": {
    "CC": {
      "mstech": 30.0,
      "stoxxo": 0.0
    },
    "CCG": {
      "mstech": 30.0,
      "stoxxo": 0.0
    },
    "PGB": {
      "mstech": 30.0,
      "stoxxo": 0.0
    },
    "PVT": {
      "mstech": 30.0,
      "stoxxo": 0.0
    }
  },
  "maxloss_algo": {
    "8": {
      "0DTE": "sheet",
      "1DTE": {
        "mstech": 1.4,
        "stoxxo": 1.4
      }
    },
    "19": {
      "0DTE": {
        "mstech": 30.0,
        "stoxxo": 10.0
      },
      "1DTE": {
        "mstech": 30.0,
        "stoxxo": 10.0
      },
      "4DTE": {
        "mstech": 30.0,
        "stoxxo": 10.0
      }
    },
    "27": {
      "0DTE": {
        "mstech": 30.0,
        "stoxxo": 3.0
      },
      "1DTE": {
        "mstech": 30.0,
        "stoxxo": 3.0
      },
      "4DTE": {
        "mstech": 30.0,
        "stoxxo": 3.0
      }
    }
  },
  "cycles": {
    "Nifty": [
      "4DTE",
      "1DTE",
      "0DTE"
    ],
    "Sensex": [
      "1DTE",
      "0DTE"
    ]
  },
  "weekday_cycles": {
    "mon": "Nifty",
    "tue": "Nifty",
    "wed": "Sensex",
    "thu": "Sensex",
    "fri": "Nifty"
  },
