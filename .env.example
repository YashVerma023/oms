# Copy to .env and fill in. Never commit .env.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=omp
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Application ---
LOG_LEVEL=INFO
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Set to false outside development.
FLASK_DEBUG=true
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
MAX_UPLOAD_MB=25

# --- Bootstrap logins (inserted only if the email is absent) ---
DEFAULT_ADMIN_ROLE=admin
DEFAULT_ADMIN_NAME=admin
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=password123

DEFAULT_SUPERADMIN_ROLE=superadmin
DEFAULT_SUPERADMIN_NAME=superadmin
DEFAULT_SUPERADMIN_EMAIL=superadmin@gmail.com
DEFAULT_SUPERADMIN_PASSWORD=password123